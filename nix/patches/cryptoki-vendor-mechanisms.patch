+#[cfg(test)]
+mod vendor_defined_tests {
+    use super::*;
+
+    /// A value in the vendor range converts to a `MechanismType` that keeps it, as
+    /// `new_vendor_defined` makes; one below it that the crate has no name for is still refused.
+    #[test]
+    fn vendor_defined_values_are_kept() {
+        let vendor = CKM_VENDOR_DEFINED | 0x0F00_0001;
+        let ty = MechanismType::try_from(vendor).unwrap();
+        assert_eq!(CK_MECHANISM_TYPE::from(ty), vendor);
+        assert_eq!(ty, MechanismType::new_vendor_defined(vendor).unwrap());
+        assert!(MechanismType::try_from(CKM_VENDOR_DEFINED - 1).is_err());
+    }
+}
