     assert(tctx);
@@ -1523,13 +1523,23 @@ CK_RV tpm_certify(tpm_ctx *tctx, tobject *tobj, uint32_t signer_handle,
 
     ESYS_CONTEXT *ectx = tctx->esys_ctx;
 
