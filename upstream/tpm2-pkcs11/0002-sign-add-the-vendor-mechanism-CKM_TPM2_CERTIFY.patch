diff --git a/src/lib/sign.c b/src/lib/sign.c
index e78c304..911e0fd 100644
--- a/src/lib/sign.c
+++ b/src/lib/sign.c
@@ -34,8 +34,74 @@ struct sign_opdata {
     int padding;
     EVP_PKEY *pkey;
     const EVP_MD *md;
+    /* CKM_TPM2_CERTIFY: the persistent TPM handle of the signing key */
+    uint32_t certify_signer;
 };
 
+/*
+ * CKM_TPM2_CERTIFY (tpm2-pkcs11-vendor.h) is not a signature over data: the TPM signs a statement
+ * about the key object, with a key the caller names. The object is certified as it is, so
+ * neither CKA_SIGN nor CKA_ALLOWED_MECHANISMS decides (decrypt-only and HMAC keys are certified
+ * too). The data of the operation is the qualifying data, buffered as for any mechanism that
+ * does not hash.
+ */
+static void sign_opdata_free(sign_opdata **opdata);
+
+static CK_RV certify_init(operation op, session_ctx *ctx, tobject *tobj, CK_MECHANISM_PTR mechanism) {
+
+    CK_RV rv = CKR_OK;
+
+    /* there is nothing to verify: the caller checks the statement */
+    if (op != operation_sign) {
+        rv = CKR_MECHANISM_INVALID;
+        goto error;
+    }
+
+    if (!mechanism->pParameter || mechanism->ulParameterLen != sizeof(CK_TPM2_CERTIFY_PARAMS)) {
+        rv = CKR_MECHANISM_PARAM_INVALID;
+        goto error;
+    }
+
+    CK_TPM2_CERTIFY_PARAMS params;
+    memcpy(&params, mechanism->pParameter, sizeof(params));
+    if (params.ulSignerHandle < 0x81000000UL || params.ulSignerHandle > 0x81FFFFFFUL) {
+        LOGE("CKM_TPM2_CERTIFY signer is not a persistent handle: 0x%lx", params.ulSignerHandle);
+        rv = CKR_MECHANISM_PARAM_INVALID;
+        goto error;
+    }
+
+    /* public key objects are not loaded in the TPM, there is nothing to certify */
+    if (!tobj->priv || !tobj->tpm_esys_tr) {
+        rv = CKR_KEY_TYPE_INCONSISTENT;
+        goto error;
+    }
+
+    sign_opdata *opdata = calloc(1, sizeof(sign_opdata));
+    if (!opdata) {
+        LOGE("oom");
+        rv = CKR_HOST_MEMORY;
+        goto error;
+    }
+
+    opdata->certify_signer = params.ulSignerHandle;
+    memcpy(&opdata->mech, mechanism, sizeof(opdata->mech));
+
+    opdata->crypto_opdata = encrypt_op_data_new();
+    if (!opdata->crypto_opdata) {
+        sign_opdata_free(&opdata);
+        rv = CKR_HOST_MEMORY;
+        goto error;
+    }
+
+    session_ctx_opdata_set(ctx, op, tobj, opdata, (opdata_free_fn)sign_opdata_free);
+
+    return CKR_OK;
+
+error:
+    tobject_user_decrement(tobj);
+    return rv;
+}
+
 static sign_opdata *sign_opdata_new(operation op, mdetail *mdtl, CK_MECHANISM_PTR mechanism, tobject *tobj) {
 
     int padding = 0;
@@ -179,6 +245,10 @@ static CK_RV common_init(operation op, session_ctx *ctx, CK_MECHANISM_PTR mechan
         return rv;
     }
 
+    if (mechanism->mechanism == CKM_TPM2_CERTIFY) {
+        return certify_init(op, ctx, tobj, mechanism);
+    }
+
     digest_op_data *digest_opdata = NULL;
     bool is_hashing_needed = false;
     rv = mech_is_hashing_needed(tok->mdtl,
@@ -337,6 +407,32 @@ CK_RV sign_final_ex(session_ctx *ctx, CK_BYTE_PTR signature, CK_ULONG_PTR signat
 
     twist digest_buf = NULL;
 
+    if (opdata->mech.mechanism == CKM_TPM2_CERTIFY) {
+        /*
+         * A size query, and a buffer too small, never reach the TPM: the output has a fixed
+         * upper bound. The buffered data is the qualifying data, nothing is hashed.
+         */
+        if (!signature) {
+            *signature_len = CK_TPM2_CERTIFY_MAX_LEN;
+            rv = CKR_OK;
+            goto out;
+        }
+
+        if (*signature_len < CK_TPM2_CERTIFY_MAX_LEN) {
+            *signature_len = CK_TPM2_CERTIFY_MAX_LEN;
+            rv = CKR_BUFFER_TOO_SMALL;
+            goto out;
+        }
+
+        rv = tpm_certify(tok->tctx, tobj, opdata->certify_signer,
+                (const CK_BYTE *)opdata->buffer, twist_len(opdata->buffer),
+                signature, signature_len);
+        if (rv != CKR_OK) {
+            goto session_out;
+        }
+        goto out;
+    }
+
     size_t expected_sig_len = 0;
     rv = tobject_get_min_buf_size(tobj, &opdata->mech, &expected_sig_len);
     if (rv != CKR_OK) {
diff --git a/src/lib/tpm.c b/src/lib/tpm.c
index 675fc42..dfcd889 100644
--- a/src/lib/tpm.c
+++ b/src/lib/tpm.c
@@ -1492,6 +1492,110 @@ CK_RV tpm_sign(tpm_op_data *opdata, CK_BYTE_PTR data, CK_ULONG datalen, CK_BYTE_
     return rv;
 }
 
+/*
+ * Whether rc is the format-one error `err` (handle, key, scheme... with their handle, parameter
+ * or session number masked out), the TPM refusing what the caller named rather than failing.
+ */
+static bool rc_is_fmt1(TSS2_RC rc, TSS2_RC err) {
+    return (rc & (TPM2_RC_FMT1 | 0x3F)) == err;
+}
+
+CK_RV tpm_certify(tpm_ctx *tctx, tobject *tobj, uint32_t signer_handle,
+        const CK_BYTE *qualifying, CK_ULONG qualifying_len,
+        CK_BYTE_PTR out, CK_ULONG_PTR outlen) {
+    assert(tctx);
+    assert(tobj);
+    assert(outlen);
+
+    if (*outlen < CK_TPM2_CERTIFY_MAX_LEN) {
+        *outlen = CK_TPM2_CERTIFY_MAX_LEN;
+        return CKR_BUFFER_TOO_SMALL;
+    }
+
+    TPM2B_DATA qualifying_data = TPM2B_EMPTY_INIT;
+    if (qualifying_len > sizeof(qualifying_data.buffer)) {
+        return CKR_DATA_LEN_RANGE;
+    }
+    if (qualifying_len) {
+        memcpy(qualifying_data.buffer, qualifying, qualifying_len);
+    }
+    qualifying_data.size = qualifying_len;
+
+    ESYS_CONTEXT *ectx = tctx->esys_ctx;
+
+    ESYS_TR signer = ESYS_TR_NONE;
+    TSS2_RC rc = Esys_TR_FromTPMPublic(ectx, signer_handle,
+            ESYS_TR_NONE, ESYS_TR_NONE, ESYS_TR_NONE, &signer);
+    if (rc != TSS2_RC_SUCCESS) {
+        LOGE("Esys_TR_FromTPMPublic(0x%x): %s", signer_handle, Tss2_RC_Decode(rc));
+        return rc_is_fmt1(rc, TPM2_RC_HANDLE) ?
+                CKR_MECHANISM_PARAM_INVALID : CKR_GENERAL_ERROR;
+    }
+
+    CK_RV rv = CKR_GENERAL_ERROR;
+    TPM2B_ATTEST *certify_info = NULL;
+    TPMT_SIGNATURE *signature = NULL;
+    /* the signer's own scheme: a signing key with one in its template uses it */
+    TPMT_SIG_SCHEME scheme = { .scheme = TPM2_ALG_NULL };
+    size_t offset = 0;
+
+    /* the signer has an empty auth value, which a password session sends as it is */
+    bool result = set_esys_auth(ectx, signer, NULL);
+    if (!result) {
+        goto out;
+    }
+
+    result = set_esys_auth(ectx, tobj->tpm_esys_tr, tobj->unsealed_auth);
+    if (!result) {
+        goto out;
+    }
+
+    flags_turndown(tctx, TPMA_SESSION_ENCRYPT);
+    rc = Esys_Certify(
+            ectx,
+            tobj->tpm_esys_tr,
+            signer,
+            tctx->hmac_session,
+            ESYS_TR_PASSWORD,
+            ESYS_TR_NONE,
+            &qualifying_data,
+            &scheme,
+            &certify_info,
+            &signature);
+    flags_restore(tctx);
+    if (rc != TSS2_RC_SUCCESS) {
+        LOGE("Esys_Certify: %s", Tss2_RC_Decode(rc));
+        if (rc_is_fmt1(rc, TPM2_RC_KEY) || rc_is_fmt1(rc, TPM2_RC_SCHEME)
+                || rc_is_fmt1(rc, TPM2_RC_TYPE) || rc_is_fmt1(rc, TPM2_RC_ATTRIBUTES)) {
+            rv = CKR_MECHANISM_PARAM_INVALID;
+        }
+        goto out;
+    }
+
+    rc = Tss2_MU_TPM2B_ATTEST_Marshal(certify_info, out, *outlen, &offset);
+    if (rc != TSS2_RC_SUCCESS) {
+        LOGE("Tss2_MU_TPM2B_ATTEST_Marshal: %s", Tss2_RC_Decode(rc));
+        goto out;
+    }
+
+    rc = Tss2_MU_TPMT_SIGNATURE_Marshal(signature, out, *outlen, &offset);
+    if (rc != TSS2_RC_SUCCESS) {
+        LOGE("Tss2_MU_TPMT_SIGNATURE_Marshal: %s", Tss2_RC_Decode(rc));
+        goto out;
+    }
+
+    *outlen = offset;
+    rv = CKR_OK;
+
+out:
+    Esys_Free(certify_info);
+    Esys_Free(signature);
+    /* a persistent object: only the ESYS_TR is released, nothing is flushed from the TPM */
+    Esys_TR_Close(ectx, &signer);
+
+    return rv;
+}
+
 CK_RV tpm_verify(tpm_op_data *opdata, CK_BYTE_PTR data, CK_ULONG datalen, CK_BYTE_PTR sig, CK_ULONG siglen) {
     assert(opdata);
 
