From 2f2825e210099ef9a6214e6e3f85aba9d93dc94a Mon Sep 17 00:00:00 2001
From: Josh Hoffer <jhoffer@sansorgan.es>
Date: Wed, 11 Nov 2026 18:42:28 -0800
Subject: [PATCH] Fix the values of the SHA-224/384/512 HMAC key types

KeyType::SHA224_HMAC, SHA384_HMAC and SHA512_HMAC were defined as
CKK_SHA256_HMAC, so keys of these types could not be created and a
CKA_KEY_TYPE read from a token came back as CKK_SHA256_HMAC. Use the
matching CKK_* values and add a test that every HMAC key type
round-trips through TryFrom<CK_KEY_TYPE>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cryptoki/src/object.rs | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/cryptoki/src/object.rs b/cryptoki/src/object.rs
index 4ad07b2..98d4ab4 100644
--- a/cryptoki/src/object.rs
+++ b/cryptoki/src/object.rs
@@ -1899,17 +1899,17 @@ impl KeyType {
 
     /// SHA384 HMAC key
     pub const SHA384_HMAC: KeyType = KeyType {
-        val: CKK_SHA256_HMAC,
+        val: CKK_SHA384_HMAC,
     };
 
     /// SHA512 HMAC key
     pub const SHA512_HMAC: KeyType = KeyType {
-        val: CKK_SHA256_HMAC,
+        val: CKK_SHA512_HMAC,
     };
 
     /// SHA224 HMAC key
     pub const SHA224_HMAC: KeyType = KeyType {
-        val: CKK_SHA256_HMAC,
+        val: CKK_SHA224_HMAC,
     };
 
     /// SEED key
@@ -2428,3 +2428,22 @@ impl TryFrom<CK_VALIDATION_AUTHORITY_TYPE> for ValidationAuthorityType {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hmac_key_types_round_trip() {
+        for raw in [
+            CKK_SHA_1_HMAC,
+            CKK_SHA224_HMAC,
+            CKK_SHA256_HMAC,
+            CKK_SHA384_HMAC,
+            CKK_SHA512_HMAC,
+        ] {
+            let key_type = KeyType::try_from(raw).unwrap();
+            assert_eq!(CK_KEY_TYPE::from(key_type), raw, "{key_type}");
+        }
+    }
+}
