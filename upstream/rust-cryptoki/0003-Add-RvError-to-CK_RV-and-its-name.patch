+            pub fn name(&self) -> Option<&'static str> {
+                match self {
+                    $(RvError::$variant => Some(stringify!($ckr)),)*
+                    RvError::VendorDefined(_) | RvError::UnknownErrorCode(_) => None,
+                }
             }
         }
