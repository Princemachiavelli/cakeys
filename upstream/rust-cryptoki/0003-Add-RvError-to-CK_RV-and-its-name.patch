+        impl From<RvError> for CK_RV {
+            /// The return value an error stands for: the inverse of `From<CK_RV> for Rv`.
+            fn from(rv_error: RvError) -> Self {
+                match rv_error {
+                    $(RvError::$variant => $ckr,)*
+                    RvError::VendorDefined(ck_rv) | RvError::UnknownErrorCode(ck_rv) => ck_rv,
