From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josh Hoffer <jhoffer@sansorgan.es>
Date: Fri, 13 Nov 2026 12:00:00 -0800
Subject: [PATCH] C_UnwrapKey: set CKA_VALUE_LEN on the unwrapped secret key

C_UnwrapKey stored the recovered CKA_VALUE of a secret key but left
CKA_VALUE_LEN at its default of 0, so an unwrapped 256-bit AES key
reported CKA_VALUE_LEN 0. A template cannot supply it: the attribute
is refused with CKR_ATTRIBUTE_READ_ONLY, as PKCS#11 (v2.40 4.1.2,
footnote 6) says it must not be specified when unwrapping, and the
mechanism contributes it with CKA_VALUE.

Set CKA_VALUE_LEN to the length of the recovered value for every
secret key type that has the attribute, and check it in the AES wrap
and unwrap test.

Fixes #628

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/lib/SoftHSM.cpp                      |  6 ++++++
 src/lib/test/SymmetricAlgorithmTests.cpp | 11 +++++++++++
 2 files changed, 17 insertions(+)

diff --git a/src/lib/SoftHSM.cpp b/src/lib/SoftHSM.cpp
--- a/src/lib/SoftHSM.cpp
+++ b/src/lib/SoftHSM.cpp
@@ -7504,6 +7504,12 @@
 				else
 					value = keydata;
 				bOK = bOK && osobject->setAttribute(CKA_VALUE, value);
+
+				// The unwrap template may not carry CKA_VALUE_LEN, the mechanism
+				// supplies it with CKA_VALUE (PKCS#11 v2.40 4.1.2, footnote 6).
+				// Key types without the attribute (DES, DES3) have nothing to set.
+				if (osobject->attributeExists(CKA_VALUE_LEN))
+					bOK = bOK && osobject->setAttribute(CKA_VALUE_LEN, (unsigned long)keydata.size());
 			}
 			else if (keyType == CKK_RSA)
 			{
diff --git a/src/lib/test/SymmetricAlgorithmTests.cpp b/src/lib/test/SymmetricAlgorithmTests.cpp
--- a/src/lib/test/SymmetricAlgorithmTests.cpp
+++ b/src/lib/test/SymmetricAlgorithmTests.cpp
@@ -1180,10 +1180,21 @@
 	CPPUNIT_ASSERT(rv == CKR_OK);
 	CPPUNIT_ASSERT(hNew != CK_INVALID_HANDLE);

+	// The unwrapped key carries the length of the recovered value (issue #628)
+	CK_ULONG unwrappedValueLen = 0UL;
+	CK_ATTRIBUTE lenAttrib[] = {
+		{ CKA_VALUE_LEN, &unwrappedValueLen, sizeof(unwrappedValueLen) }
+	};
+	rv = CRYPTOKI_F_PTR( C_GetAttributeValue(hSession, hNew, lenAttrib, sizeof(lenAttrib)/sizeof(CK_ATTRIBUTE)) );
+	CPPUNIT_ASSERT(rv == CKR_OK);
+	CPPUNIT_ASSERT(unwrappedValueLen == keyLen);
+
 	free(wrappedPtr);
 	wrappedPtr = NULL_PTR;
 	rv = CRYPTOKI_F_PTR( C_DestroyObject(hSession, hSecret) );
 	CPPUNIT_ASSERT(rv == CKR_OK);
+	rv = CRYPTOKI_F_PTR( C_DestroyObject(hSession, hNew) );
+	CPPUNIT_ASSERT(rv == CKR_OK);
 }

 void SymmetricAlgorithmTests::aesWrapUnwrapNonModifiableGeneric(CK_MECHANISM_TYPE mechanismType, CK_SESSION_HANDLE hSession, CK_OBJECT_HANDLE hKey)
