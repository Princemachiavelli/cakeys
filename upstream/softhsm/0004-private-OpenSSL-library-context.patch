diff -ru a/src/lib/crypto/OSSLUtil.cpp b/src/lib/crypto/OSSLUtil.cpp
--- a/src/lib/crypto/OSSLUtil.cpp
+++ b/src/lib/crypto/OSSLUtil.cpp
@@ -209,3 +209,71 @@
 	return NID_undef;
 }
 #endif
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#include <openssl/provider.h>
+#include <map>
+#include <mutex>
+#include <string>
+
+// SoftHSM's library context: the default provider only, no configuration file
+static OSSL_LIB_CTX* softhsmLibCtx()
+{
+	static OSSL_LIB_CTX* ctx = []() -> OSSL_LIB_CTX*
+	{
+		OSSL_LIB_CTX* c = OSSL_LIB_CTX_new();
+		if (c != NULL && OSSL_PROVIDER_load(c, "default") == NULL)
+		{
+			ERROR_MSG("Could not load the default provider into SoftHSM's library context");
+			OSSL_LIB_CTX_free(c);
+			c = NULL;
+		}
+		return c;
+	}();
+	return ctx;
+}
+
+// Fetched implementations live as long as the module: callers hold plain pointers
+template <typename T>
+static const T* fetchOnce(const T* given, const char* name, T* (*fetch)(OSSL_LIB_CTX*, const char*, const char*))
+{
+	static std::mutex lock;
+	static std::map<std::string, T*> cache;
+
+	OSSL_LIB_CTX* ctx = softhsmLibCtx();
+	if (given == NULL || name == NULL || ctx == NULL) return given;
+
+	std::lock_guard<std::mutex> guard(lock);
+	auto it = cache.find(name);
+	if (it != cache.end()) return it->second;
+
+	T* impl = fetch(ctx, name, NULL);
+	if (impl == NULL)
+	{
+		ERROR_MSG("Could not fetch %s from SoftHSM's library context", name);
+		return given;
+	}
+	cache[name] = impl;
+	return impl;
+}
+
+const EVP_MD* OSSL::fetched(const EVP_MD* md)
+{
+	return fetchOnce<EVP_MD>(md, md == NULL ? NULL : EVP_MD_get0_name(md), EVP_MD_fetch);
+}
+
+const EVP_CIPHER* OSSL::fetched(const EVP_CIPHER* cipher)
+{
+	return fetchOnce<EVP_CIPHER>(cipher, cipher == NULL ? NULL : EVP_CIPHER_get0_name(cipher), EVP_CIPHER_fetch);
+}
+#else
+const EVP_MD* OSSL::fetched(const EVP_MD* md)
+{
+	return md;
+}
+
+const EVP_CIPHER* OSSL::fetched(const EVP_CIPHER* cipher)
+{
+	return cipher;
+}
+#endif
